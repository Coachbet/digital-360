      "id": "56cc46c0-6b9f-4ec2-a133-9531387e18cc",
      "name": "Lancer le rapport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "adgi360 Bot API"
        }
