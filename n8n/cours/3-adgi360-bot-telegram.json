      "id": "5bfeb6a8-bd93-4426-8188-902b0105cdde",
      "name": "Lancer le rapport",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2200,
        -360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "adgi360 Bot API"
