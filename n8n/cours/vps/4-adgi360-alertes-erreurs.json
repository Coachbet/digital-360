{
  "name": "adgi360 – Alertes erreurs",
  "nodes": [
    {
      "parameters": {},
      "id": "25ad1c95-41e6-4422-b2e7-adba775913e4",
      "name": "Erreur dans un workflow",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "notes": "Déclenché par n8n quand un workflow qui désigne celui-ci comme « Error workflow » échoue."
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "90f763e6-7357-4f9c-8034-6e53c3f763a3",
              "name": "admin_chat_id",
              "value": "0",
              "type": "number"
            }
          ]
        },
        "options": {},
        "includeOtherFields": true
      },
      "id": "1cfb6479-439c-4bf1-8a38-4f95b7218073",
      "name": "Configuration",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "notes": "Remplacer 0 par votre chat_id Telegram (visible dans une exécution du bot : chat.id)."
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst lines = [\n  '🚨 Digital 360 — erreur n8n',\n  `Workflow : ${e.workflow?.name || '?'}`,\n  `Étape : ${e.execution?.lastNodeExecuted || '?'}`,\n  `Erreur : ${String(e.execution?.error?.message || 'inconnue').slice(0, 500)}`,\n  e.execution?.url ? `Exécution : ${e.execution.url}` : '',\n];\nreturn [{ json: { admin_chat_id: e.admin_chat_id, text: lines.filter(Boolean).join('\\n') } }];"
      },
      "id": "305ef866-7535-4f12-97a7-2d3f92ac5e07",
      "name": "Formater l'alerte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.admin_chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "6418b88d-ecfc-43b1-b51b-c851e5084359",
      "name": "Prévenir l'administrateur",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        660,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "",
          "name": "adgi360 Bot"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    }
  ],
