        "model": "llama3.2:3b",
        "options": {
          "temperature": 0,
          "format": "json"
        }
      },
      "id": "394df6e0-478b-4dfc-8f23-a28b6f7586a4",
      "name": "Ollama",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "ollamaApi": {
