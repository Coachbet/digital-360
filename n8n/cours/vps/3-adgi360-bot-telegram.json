        "model": "llama3.2:3b",
        "options": {
          "temperature": 0,
          "format": "json"
        }
      },
      "id": "f753c8ad-e41d-4cc5-9e32-ac68675152de",
      "name": "Ollama",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [
        1320,
