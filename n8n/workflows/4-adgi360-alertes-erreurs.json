      "position": [
        220,
        0
      ],
      "notes": "Remplacer 0 par votre chat_id Telegram (visible dans une exécution du bot : chat.id)."
    },
    {
      "parameters": {
        "jsCode": "const e = $input.first().json;\nconst lines = [\n  '🚨 Digital 360 — erreur n8n',\n  `Workflow : ${e.workflow?.name || '?'}`,\n  `Étape : ${e.execution?.lastNodeExecuted || '?'}`,\n  `Erreur : ${String(e.execution?.error?.message || 'inconnue').slice(0, 500)}`,\n  e.execution?.url ? `Exécution : ${e.execution.url}` : '',\n];\nreturn [{ json: { admin_chat_id: e.admin_chat_id, text: lines.filter(Boolean).join('\\n') } }];"
      },
      "id": "bc0d4298-db9b-4bc5-8516-4626de4346b8",
      "name": "Formater l'alerte",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $json.admin_chat_id }}",
        "text": "={{ $json.text }}",
