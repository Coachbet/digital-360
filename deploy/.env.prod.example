# ---------------------------------------------------------------------------
# Digital 360 — variables de production
#
# Copier en .env.prod, remplir, puis NE JAMAIS COMMITER ce fichier.
# Générer chaque secret avec :  openssl rand -hex 32
# ---------------------------------------------------------------------------

# --- Domaines (les enregistrements DNS A doivent déjà pointer sur le serveur)
APP_DOMAIN=app.digital360.ca
FILES_DOMAIN=files.digital360.ca
N8N_DOMAIN=n8n.digital360.ca
# Adresse à laquelle Let's Encrypt prévient d'un problème de certificat.
ACME_EMAIL=admin@digital360.ca

# --- Sécurité applicative
# Signe les jetons de session. La changer déconnecte tout le monde d'un coup.
SECRET_KEY=
# Chiffre les jetons Meta/Google/TikTok enregistrés. La perdre rend les
# identifiants existants illisibles : la sauvegarder avec les autres secrets.
CREDENTIALS_ENCRYPTION_KEY=
META_GRAPH_API_VERSION=v23.0
# Secret partagé avec n8n (credential « adgi360 Bot API », en-tête X-Bot-Token).
BOT_API_TOKEN=

# --- PostgreSQL (jamais exposé sur Internet)
POSTGRES_USER=digital360
POSTGRES_PASSWORD=
POSTGRES_DB=digital360

# --- MinIO (stockage des fichiers, jamais exposé en écriture)
MINIO_ROOT_USER=digital360
MINIO_ROOT_PASSWORD=
S3_BUCKET=digital360-files
S3_REGION=us-east-1

# --- n8n
N8N_USER=admin
N8N_PASSWORD=
# Chiffre les identifiants enregistrés dans n8n. À sauvegarder avec le reste :
# si elle est perdue, les credentials stockés deviennent illisibles.
N8N_ENCRYPTION_KEY=

# Token du bot Telegram (BotFather). Passé à n8n en variable d'environnement,
# lu par {{ $env.TELEGRAM_BOT_TOKEN }} : jamais dans un workflow ni dans Git.
TELEGRAM_BOT_TOKEN=
