# Base de données PostgreSQL (docker-compose à la racine du projet)
# Publié sur 5433 côté hôte car 5432 est déjà occupé sur cette machine.
DATABASE_URL=postgresql+asyncpg://adgi360:adgi360@localhost:5433/adgi360

# Stockage fichiers MinIO (compatible S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=adgi360
S3_SECRET_KEY=adgi360secret
S3_BUCKET=adgi360-files
S3_REGION=us-east-1
# Endpoint utilisé pour signer les URL remises à n8n. Le conteneur n8n ne résout
# pas « localhost » : il faut signer avec l'adresse qu'il utilisera réellement.
S3_N8N_ENDPOINT_URL=http://host.docker.internal:9000
# Vide en local : le navigateur et le backend voient MinIO à la même adresse.
# En production, ce sera le domaine public (ex. https://files.digital360.ca).
S3_PUBLIC_ENDPOINT_URL=

# n8n (instance locale)
# Workflow 1 : génère le PowerPoint et le dépose dans MinIO
N8N_WEBHOOK_URL=http://localhost:5678/webhook/auto-review

# CORS (origine du frontend en local)
FRONTEND_ORIGIN=http://localhost:5173

# Sécurité. Générer deux valeurs différentes avec : openssl rand -hex 32
SECRET_KEY=dev-secret-a-remplacer
CREDENTIALS_ENCRYPTION_KEY=dev-cle-chiffrement-a-remplacer

# Meta Ads / Instagram
META_GRAPH_API_VERSION=v23.0
