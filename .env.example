# Copier en .env à la racine :  cp .env.example .env
# Valeurs de DÉVELOPPEMENT LOCAL uniquement. La production utilise
# deploy/.env.prod (modèle : deploy/.env.prod.example).

# PostgreSQL : base du projet (portail + journal du bot)
POSTGRES_USER=adgi360
POSTGRES_PASSWORD=adgi360
POSTGRES_DB=adgi360

# MinIO : stockage des exports Excel et des PowerPoint
MINIO_ROOT_USER=adgi360
MINIO_ROOT_PASSWORD=adgi360secret
S3_BUCKET=adgi360-files

# n8n : clé qui chiffre les credentials. Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Token du bot Telegram (BotFather → /mybots → API Token).
# Lu par n8n via $env.TELEGRAM_BOT_TOKEN, jamais écrit dans un workflow.
TELEGRAM_BOT_TOKEN=
